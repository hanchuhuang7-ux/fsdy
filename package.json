{
  "name": "frontline-lab",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "description": "Native Unity 3D physics battle sandbox for Windows and WebGL",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node Tools/serve-web.mjs",
    "build": "node Tools/unity.mjs build",
    "build:windows": "node Tools/unity.mjs windows",
    "build:web": "node Tools/unity.mjs web",
    "test": "node --test test/*.test.js Tools/v07.test.mjs Tools/v08.test.mjs Tools/v09.test.mjs Tools/v10.test.mjs && node Tools/check-core.mjs",
    "test:core": "node Tools/check-core.mjs",
    "test:physics": "node Tools/unity.mjs physics",
    "benchmark": "node Tools/unity.mjs benchmark",
    "benchmark:legacy": "node scripts/benchmark.mjs",
    "dev:legacy": "vite --host 127.0.0.1",
    "build:legacy": "vite build",
    "battle": "node Tools/unity.mjs smoke",
    "tournament": "node Tools/unity.mjs tournament",
    "agent-battle": "node Tools/unity.mjs agent"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
